	setAttr ".vtn" -type "string" "ACES 1.0 SDR-video (sRGB)";
	setAttr ".vn" -type "string" "ACES 1.0 SDR-video";
	setAttr ".dn" -type "string" "sRGB";
	setAttr ".wsn" -type "string" "ACEScg";
	setAttr ".otn" -type "string" "ACES 1.0 SDR-video (sRGB)";
	setAttr ".potn" -type "string" "ACES 1.0 SDR-video (sRGB)";
select -ne :hardwareRenderGlobals;
	setAttr ".ctrs" 256;
	setAttr ".btrs" 512;
select -ne :ikSystem;
	setAttr -s 4 ".sol";
connectAttr "groupId154.id" "bookz.iog.og[0].gid";
connectAttr ":initialShadingGroup.mwc" "bookz.iog.og[0].gco";
connectAttr "groupId149.id" "bookz.ciog.cog[0].cgid";
connectAttr "bookz.ciog.cog[0]" ":initialShadingGroup.dsm" -na;
connectAttr "bookz.iog.og[0]" ":initialShadingGroup.dsm" -na;
connectAttr "groupId154.msg" ":initialShadingGroup.gn" -na;
// End of Bukz.ma
